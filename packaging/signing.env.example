# NOTARIZE-1: Developer ID signing + notarization environment (TEMPLATE).
#
# This file is a safe-to-commit example. Copy it to `signing.env` (which
# must stay out of version control) and fill in the real values before
# running the signing/notarization flow. `signing.env` is shell-sourceable:
#   source packaging/signing.env
#
# All values below are PLACEHOLDERS. Nothing here is a real credential.

# The full Developer ID signing identity string.
# Obtain with: security find-identity -v -p codesigning
# (look for the line like: "Developer ID Application: Your Name (TEAMID)")
export DEVELOPER_ID_APP="Developer ID Application: Your Name (TEAMID)"

# The 10-character Apple Developer Team ID (e.g. "ABCDE12345").
# Visible in Apple Developer account: https://developer.apple.com
#   -> Membership / Team details (or the "Team" shown in Xcode).
export APPLE_TEAM_ID="ABCDE12345"

# A `notarytool` keychain profile name used to submit for notarization.
# Create one with:
#   xcrun notarytool store-credentials "NOTARY_PROFILE" \
#     --team-id "ABCDE12345" --apple-id ... --password ...
# (the Apple ID / App Store password / app-specific password live in the
# keychain, NOT in this file)
export NOTARY_PROFILE="oatmeal-notary"

# Opt-in toggle: when set to 1, the build pipeline signs with Developer ID
# and submits for notarization. Leave unset/0 for local ad-hoc builds.
export MR_SIGN=1
